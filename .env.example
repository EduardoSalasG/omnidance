# API
DATABASE_URL="postgresql://omnidance:omnidance@localhost:5432/omnidance"
REDIS_URL="redis://localhost:6379"
PORT=4000
JWT_SECRET="dev-secret-change-me"
QR_SECRET="dev-qr-secret-change-me"

# Auth (Google OAuth - fill when ready)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (magic links)
RESEND_API_KEY=""
EMAIL_FROM="Omnidance <noreply@omnidance.cl>"

# Seeds - dev (default) siembra la demo SBK; prod solo baseline + admin
# SEED_ENV="dev"            # dev | prod
# SEED_ADMIN_EMAIL=""       # requerido si SEED_ENV=prod
# SEED_ADMIN_NAME=""        # opcional (default "Admin Omnidance")

# Flow (payments) - credenciales en sandbox.flow.cl → Mis datos → Integraciones
PAYMENT_GATEWAY="stub"   # stub = simulado local · flow = Flow real
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
FLOW_BASE_URL="https://sandbox.flow.cl/api"  # prod: https://www.flow.cl/api
# MercadoPago (adaptador extra del GatewayRegistry - convive con Flow):
# se registra cuando el token existe; webhook en
# /api/payments/webhook/MERCADOPAGO. test- = sandbox, APP_USR- = prod.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_BASE_URL="https://api.mercadopago.com"
# Fintoc (adaptador extra del GatewayRegistry - A2A CL/MX): se registra
# cuando la key existe; checkout sessions v2 + webhook firmado en
# /api/payments/webhook/FINTOC. El whsec_ es el secret del endpoint
# que se registra en el dashboard de Fintoc (sk_test_ = modo test).
FINTOC_SECRET_KEY=""
FINTOC_WEBHOOK_SECRET=""
FINTOC_BASE_URL="https://api.fintoc.com"
# URL pública de la API para el webhook de Flow (urlConfirmation)
API_URL="http://localhost:4000"
# Cifrado AES-256-GCM de credenciales de pasarela del productor
# (PUT /producer/gateway-account). Generar: `openssl rand -hex 32`.
PRODUCER_GATEWAY_KEY=""

# Web Push - generar con `npx web-push generate-vapid-keys` (en apps/api).
# Sin keys el sender opera como no-op seguro; el opt-in del front se oculta
# si falta NEXT_PUBLIC_VAPID_PUBLIC_KEY.
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="mailto:soporte@omnidance.cl"

# Web app
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Basemap CARTO Dark Matter del mapa de locales - gratis ~5M tiles/mes,
# key por email en https://carto.com/basemaps/apikey. Sin key: Esri Dark Gray.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=""

# Storage de comprobantes de pago directo (academia-payment-claims).
# Dev: default ./uploads (relativo a apps/api). Prod VM: apuntar a un
# path persistido por volumen en el disco - p.ej. /app/uploads con
# bind mount al disco dedicado.
# UPLOADS_DIR="./uploads"

# Acceso externo (dev tunnels / LAN) - apps/api
# CORS allowlist: origen del web (coma-separado si hay varios).
CORS_ORIGINS="http://localhost:3000"
# Redirect del magic link verify → URL pública del web.
WEB_URL="http://localhost:3000"
# Cookie cross-site (web y API en hosts distintos, p.ej. devtunnels):
# SESSION_SAMESITE=none fuerza secure=true (requiere https).
SESSION_SAMESITE="lax"
# En prod (HTTPS): SESSION_SECURE=true → cookie Secure obligatoria.
# SESSION_SECURE="true"
