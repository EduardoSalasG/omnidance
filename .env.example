# API
DATABASE_URL="postgresql://omnidance:omnidance@localhost:5432/omnidance"
REDIS_URL="redis://localhost:6379"
PORT=4000
JWT_SECRET="dev-secret-change-me"
QR_SECRET="dev-qr-secret-change-me"

# Auth (Google OAuth — fill when ready)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (magic links)
RESEND_API_KEY=""
EMAIL_FROM="Omnidance <noreply@omnidance.cl>"

# Seeds — dev (default) siembra la demo SBK; prod solo baseline + admin
# SEED_ENV="dev"            # dev | prod
# SEED_ADMIN_EMAIL=""       # requerido si SEED_ENV=prod
# SEED_ADMIN_NAME=""        # opcional (default "Admin Omnidance")

# Flow (payments)
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
FLOW_BASE_URL="https://sandbox.flow.cl/api"

# Web Push — generar con `npx web-push generate-vapid-keys` (en apps/api).
# Sin keys el sender opera como no-op seguro; el opt-in del front se oculta
# si falta NEXT_PUBLIC_VAPID_PUBLIC_KEY.
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="mailto:soporte@omnidance.cl"

# Web app
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
