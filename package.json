{
  "name": "omnidance",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @omnidance/web dev",
    "dev:api": "pnpm --filter @omnidance/api dev",
    "build": "pnpm -r run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @omnidance/api prisma db push",
    "db:migrate": "pnpm --filter @omnidance/api prisma migrate dev",
    "db:seed": "pnpm --filter @omnidance/api prisma db seed",
    "db:studio": "pnpm --filter @omnidance/api prisma studio",
    "test": "pnpm -r run test"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
