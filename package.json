{
  "name": "omnidance",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "multer": ">=2.3.0",
      "js-yaml": ">=4.3.2",
      "qs": ">=6.16.0",
      "body-parser": ">=1.20.6",
      "uuid": ">=11.1.1",
      "postcss": ">=8.5.23",
      "source-map-js": ">=1.2.2"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @omnidance/web dev",
    "dev:api": "pnpm --filter @omnidance/api dev",
    "build": "pnpm -r run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @omnidance/api prisma db push",
    "db:migrate": "pnpm --filter @omnidance/api prisma migrate dev",
    "db:seed": "pnpm --filter @omnidance/api prisma db seed",
    "db:studio": "pnpm --filter @omnidance/api prisma studio",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
